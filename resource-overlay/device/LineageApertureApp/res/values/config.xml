<resources>
    <!-- Expose the standalone global macro sensor. -->
    <bool name="config_enableAuxCameras">true</bool>

    <!-- List of ID of auxiliary cameras that must be ignored by the app. -->
    <string-array name="config_ignoredAuxCameraIds" />

    <!-- Exclude unsupported macro video frame rates. -->
    <string-array name="config_additionalVideoConfigurations">
        <item>2</item>
        <item>sd|hd|fhd|uhd</item>
        <item>-24|-60|-120</item>
    </string-array>
</resources>
